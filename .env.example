APP_NAME=falange-mvp
APP_ENV=local
APP_VERSION=0.1.0
APP_DEBUG=true
# Local/testes: SQLite. Produção: PostgreSQL na rede privada falange-internal, ex.:
# DATABASE_URL=postgresql+psycopg://falange:SENHA@falange-postgres:5432/falange
DATABASE_URL=sqlite:///data/falange.db
# Papel somente leitura do Grafana (recebe SELECT nas views de métricas no Postgres)
GRAFANA_DB_ROLE=grafana_ro
# Origens permitidas para o beacon da landing page (CORS), separadas por vírgula
CORS_ALLOW_ORIGINS=https://www.falangelabs.io,https://falangelabs.io
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
META_APP_SECRET=change-me
META_GRAPH_API_VERSION=v23.0
META_VALIDATE_SIGNATURE=false
